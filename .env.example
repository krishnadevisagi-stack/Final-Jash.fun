# Gemini API Credentials (required for customized quote generation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Google Cloud Storage Configuration (required for production-level storage management)
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=

# Secret token to authorize periodic database/storage cleanup cron runs
CRON_SECRET=

# Gmail API OAuth2 Credentials for Application Sender Account
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Razorpay Standard Sandbox API Credentials
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# sync
